# Konfigurasi AI API Keys
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Kunci Rahasia Admin & Autentikasi Pengguna
ADMIN_SECRET_KEY=ganti_dengan_kunci_admin_rahasia_anda
SECRET_KEY=ganti_dengan_secret_key_acak_untuk_jwt_token_auth

# Akun Admin Default Saat Inisialisasi Database
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti_dengan_password_admin_yang_kuat_2026

# Kebijakan Keamanan CORS & Debugging
# Pisahkan beberapa origin dengan koma, atau gunakan '*' jika ingin mengizinkan semua domain
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-frontend.vercel.app
FLASK_DEBUG=0

# Konfigurasi Kebijakan Rate Limiting Kuota AI Server
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=600

# Port Server Backend (Default: 5000)
PORT=5000
